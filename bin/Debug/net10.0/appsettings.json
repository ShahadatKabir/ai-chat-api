{
  "Jwt": {
    "Key": "USE_ENVIRONMENT_VARIABLE_FOR_JWT_KEY",
    "Issuer": "AiChatApi",
    "Audience": "AiChatApiUsers",
    "ExpiryMinutes": 60
  },
  "Gemini": {
    "ApiKey": "YOUR_API_KEY_HERE",
    "Model": "gemini-pro"
  },
  "Gemma": {
    "ApiUrl": "http://localhost:11434/api/generate",
    "Model": "gemma"
  },
  "RateLimiting": {
    "MaxRequestsPerMinute": 60,
    "MaxRequestsPerHour": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DataStorage": {
    "UsersFile": "data/users.json",
    "HistoryFile": "data/history.json",
    "SessionsFile": "data/sessions.json",
    "FavoritesFile": "data/favorites.json",
    "AuditLogFile": "data/audit.log"
  }
}